# =========================
# ORBIT - GITIGNORE
# =========================

# System & temporary files
*.log
*.class
*.swp
.DS_Store
.history/
*.tmp

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Flutter / Dart
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id

# Flutter generated files
app.*.symbols
app.*.map.json
.widget_preview/

# Android build outputs
android/app/debug/
android/app/profile/
android/app/release/

# =========================
# FIREBASE FUNCTIONS
# =========================

# Node.js dependencies
functions/node_modules/

# Generated TypeScript build
functions/lib/
functions/src/*.js
functions/src/*.js.map

# Firebase local files
.firebase/
firebase-debug.log*

# =========================
# SECRETS - NEVER PUSH!
# =========================
functions/.secret.local
functions/.env*

# Other environment secrets
.env
.env.*
!.env.example

# Firebase local credentials
functions/.runtimeconfig.json
