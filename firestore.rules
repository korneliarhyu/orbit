
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    // =========================================
    // 1. PLAYER PROFILE
    // =========================================
    match /players/{userId} {
      allow read, write: if isOwner(userId);
    }

    // =========================================
    // 2. MATCHED NPCs
    // =========================================
    match /players/{userId}/matches/{npcId} {

      allow read: if isOwner(userId);

      // Flutter can create a new active match.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'npcId',
          'name',
          'age',
          'species',
          'avatarIndex',
          'bio',
          'archetypeId',
          'archetype',
          'traits',
          'career',
          'npcStarts',
          'firstMessage',
          'opened',
          'matchedAt',
          'relationshipStatus',
          'intimacy'
        ])
        && request.resource.data.keys().hasAll([
          'npcId',
          'relationshipStatus',
          'opened',
          'intimacy'
        ])
        && request.resource.data.npcId == npcId
        && request.resource.data.relationshipStatus == 'active'
        && request.resource.data.opened == false
        && request.resource.data.intimacy is map
        && request.resource.data.intimacy.score == 0
        && request.resource.data.intimacy.level == 1
        && request.resource.data.intimacy.totalExchanges == 0
        && request.resource.data.intimacy.activeDays == 0
        && request.resource.data.intimacy.xpToday == 0
        && request.resource.data.intimacy.lastActiveDay == null
        && request.resource.data.intimacy.keys().hasOnly([
          'score',
          'level',
          'totalExchanges',
          'activeDays',
          'xpToday',
          'lastActiveDay'
        ]);

      // Flutter can ONLY mark a match as opened.
      allow update: if isOwner(userId)
        && resource.data.opened == false
        && request.resource.data.opened == true
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['opened']);

      // Match deletion is prohibited.
      allow delete: if false;
    }

    // =========================================
    // 3. NPC CHAT MESSAGES
    // =========================================
    match /players/{userId}/matches/{npcId}/messages/{messageId} {

      // Player can read their own chat history.
      allow read: if isOwner(userId)
        && exists(
          /databases/$(database)/documents/players/$(userId)/matches/$(npcId)
        );

      // All message writes must go through
      // Firebase Cloud Functions.
      allow create, update, delete: if false;
    }
  }
}
