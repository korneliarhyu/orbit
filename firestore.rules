
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    // =========================================
    // 1. PLAYER PROFILE
    // =========================================
    match /players/{userId} {
      allow read, write: if isOwner(userId);
    }

    // =========================================
    // 2. MATCHED NPCs
    // =========================================
    match /players/{userId}/matches/{npcId} {

      allow read: if isOwner(userId);

      // Flutter can create a new active match.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'npcId',
          'name',
          'age',
          'species',
          'avatarIndex',
          'bio',
          'archetypeId',
          'archetype',
          'traits',
          'career',
          'npcStarts',
          'firstMessage',
          'opened',
          'matchedAt',
          'relationshipStatus',
          'intimacy'
        ])
        && request.resource.data.keys().hasAll([
          'npcId',
          'relationshipStatus',
          'opened',
          'intimacy'
        ])
        && request.resource.data.npcId == npcId
        && request.resource.data.relationshipStatus == 'active'
        && request.resource.data.opened == false
        && request.resource.data.intimacy is map
        && request.resource.data.intimacy.score == 0
        && request.resource.data.intimacy.level == 1
        && request.resource.data.intimacy.totalExchanges == 0
        && request.resource.data.intimacy.activeDays == 0
        && request.resource.data.intimacy.xpToday == 0
        && request.resource.data.intimacy.lastActiveDay == null
        && request.resource.data.intimacy.keys().hasOnly([
          'score',
          'level',
          'totalExchanges',
          'activeDays',
          'xpToday',
          'lastActiveDay'
        ]);

      // Flutter can ONLY mark a match as opened.
      allow update: if isOwner(userId)
        && resource.data.opened == false
        && request.resource.data.opened == true
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['opened']);

      // Match deletion is prohibited.
      allow delete: if false;
    }

    // =========================================
    // 3. NPC CHAT MESSAGES
    // =========================================
    match /players/{userId}/matches/{npcId}/messages/{messageId} {

      function matchExists() {
        return exists(
          /databases/$(database)/documents/players/$(userId)/matches/$(npcId)
        );
      }

      // Shared message visibility rules.
      function messageRevealAt() {
        let displayAt = resource.data.get('displayAt', null);

        return displayAt is timestamp
          ? displayAt
          : resource.data.get('createdAt', null);
      }

      // Check whether the message is already visible.
      function isMessageVisible() {
        let revealAt = messageRevealAt();

        return revealAt is timestamp
          && revealAt <= request.time;
      }

      // Player can read their own chat history.
      allow read: if isOwner(userId)
        && matchExists();

      // Player can ONLY mark an incoming NPC message as read.
      allow update: if isOwner(userId)
        && matchExists()

        // Incoming NPC messages only.
        && resource.data.sender == 'npc'

        // Scheduled messages cannot be marked as read early.
        && isMessageVisible()

        // Message has not been marked as read previously.
        && resource.data.get('playerReadAt', null) == null

        // Only playerReadAt may be changed.
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['playerReadAt'])

        // Must use the current server timestamp.
        && request.resource.data.playerReadAt is timestamp
        && request.resource.data.playerReadAt == request.time;

      // Message creation and deletion remain backend-only.
      allow create, delete: if false;
    }
  }
}
